PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

DB_HOST=localhost
DB_PORT=3306
DB_NAME=bookease
DB_USER=root
DB_PASSWORD=your-mysql-password

# Optional: leave SMTP_HOST blank to disable booking confirmation emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=BookEase <bookings@example.com>
